{
  "name": "biogate-dashboard",
  "version": "1.0.0",
  "description": "Dashboard de surveillance BioGate – Edge AI Access Control",
  "main": "out/main/index.js",
  "scripts": {
    "dev":   "electron-vite dev",
    "build": "electron-vite build",
    "pack":  "npm run build && electron-builder --dir",
    "dist":  "npm run build && electron-builder"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "electron":             "^29.0.0",
    "electron-builder":     "^24.13.0",
    "electron-vite":        "^2.1.0",
    "react":                "^18.3.0",
    "react-dom":            "^18.3.0"
  },
  "build": {
    "appId":       "com.biogate.dashboard",
    "productName": "BioGate Dashboard",
    "directories": { "output": "dist-electron" },
    "win":   { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
